@page
@model ProjectDefense.Web.Pages.Student.Reservations.ChangeModel

@{
    ViewData["Title"] = Localizer["ChangeReservationTitle"];
}

<h2>@Localizer["ChangeReservationTitle"]</h2>

@if (Model.CurrentReservation != null)
{
    <div>
        <strong>@Localizer["CurrentReservation"]</strong><br />
        @Localizer["Room"]: @Model.CurrentReservation.InstructorAvailability.Room.Name<br />
        @Localizer["Date"]: @Model.CurrentReservation.StartTime.ToString("d", System.Globalization.CultureInfo.CurrentCulture)<br />
        @Localizer["Time"]: @Model.CurrentReservation.StartTime.ToString("t", System.Globalization.CultureInfo.CurrentCulture) - @Model.CurrentReservation.EndTime.ToString("t", System.Globalization.CultureInfo.CurrentCulture)
    </div>
}

@if (Model.AvailableSlots != null && Model.AvailableSlots.Any())
{
    <table class="table table-bordered mt-4">
        <thead>
            <tr>
                <th>@Localizer["TimeColumn"]</th>
                <th>@Localizer["InstructorColumn"]</th>
                <th>@Localizer["ActionColumn"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var slot in Model.AvailableSlots)
            {
                <tr>
                    <td>@slot.StartTime.ToString("t", System.Globalization.CultureInfo.CurrentCulture) - @slot.EndTime.ToString("t", System.Globalization.CultureInfo.CurrentCulture)</td>
                    <td>@slot.InstructorAvailability.Instructor.FirstName</td>
                    <td>
                        <form method="post">
                            <input type="hidden" name="NewSlotId" value="@slot.Id" />
                            <button type="submit" class="btn btn-primary btn-sm">@Localizer["SelectTimeButton"]</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        @Localizer["NoAvailableSlots"]
    </div>
}

<a asp-page="Index" class="btn btn-secondary mt-3">@Localizer["Back"]</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
