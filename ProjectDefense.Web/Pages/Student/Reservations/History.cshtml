@page
@model ProjectDefense.Web.Pages.Student.Reservations.HistoryModel

@{
    ViewData["Title"] = Localizer["MyPreviousReservationsTitle"];
}

<h2>@Localizer["MyPreviousReservationsTitle"]</h2>

@if (Model.HistoryReservations.Any())
{
    <table class="table table-striped">
        <thead>
        <tr>
            <th>@Localizer["RoomLabel"]</th>
            <th>@Localizer["DateLabel"]</th>
            <th>@Localizer["TimeLabel"]</th>
            <th>@Localizer["StatusLabel"]</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var reservation in Model.HistoryReservations)
        {
            <tr>
                <td>@reservation.InstructorAvailability.Room.Name</td>
                <td>@reservation.StartTime.ToString("d", System.Globalization.CultureInfo.CurrentCulture)</td>
                <td>@reservation.StartTime.ToString("t", System.Globalization.CultureInfo.CurrentCulture) - @reservation.EndTime.ToString("t", System.Globalization.CultureInfo.CurrentCulture)</td>
                <td>
                    @if (reservation.StudentId != null)
                    {
                        <span>@Localizer["CompletedLabel"]</span>
                    }
                    else
                    {
                        <span>@Localizer["CancelledByUserLabel"]</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">@Localizer["NoPreviousReservations"]</div>
}

<a asp-page="Index" class="btn btn-secondary mt-2">@Localizer["BackButton"]</a>