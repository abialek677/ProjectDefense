@page
@model ProjectDefense.Web.Pages.Student.Reservations.Index

@{
    ViewData["Title"] = Localizer["MyReservationsTitle"];
}

<div class="row">
    <div class="col-md-12">
        <h1>@Localizer["MyReservationsTitle"]</h1>

        <a asp-page="History" class="btn btn-outline-info mb-3">@Localizer["ViewReservationHistory"]</a>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (Model.MyReservation != null)
        {
            <div class="alert alert-info">
                <h4>@Localizer["YourCurrentReservation"]</h4>
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">
                            @Model.MyReservation.InstructorAvailability.Room.Name
                            (@Model.MyReservation.InstructorAvailability.Room.RoomNumber)
                        </h5>
                        <p class="card-text">
                            <strong>@Localizer["DateLabel"]</strong> @Model.MyReservation.StartTime.ToString("d", System.Globalization.CultureInfo.CurrentCulture)<br />
                            <strong>@Localizer["TimeLabel"]</strong> @Model.MyReservation.StartTime.ToString("t", System.Globalization.CultureInfo.CurrentCulture)
                            - @Model.MyReservation.EndTime.ToString("t", System.Globalization.CultureInfo.CurrentCulture)<br />
                            <strong>@Localizer["InstructorLabel"]</strong> @Model.MyReservation.InstructorAvailability.Instructor.FirstName @Model.MyReservation.InstructorAvailability.Instructor.LastName
                        </p>
                        <form method="post" asp-page-handler="Cancel" class="d-inline">
                            <button type="submit" class="btn btn-danger"
                                    onclick="return confirm('@Localizer["CancelReservationButton"]?');">
                                @Localizer["CancelReservationButton"]
                            </button>
                        </form>
                        <a asp-page="Change" class="btn btn-warning">@Localizer["ChangeDateButton"]</a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                <strong>@Localizer["NoActiveReservation"]</strong>
            </div>

            @if (Model.FreeReservations.Any())
            {
                <h3>@Localizer["AvailableSlotsTitle"]</h3>
                <p class="text-muted">@Localizer["AvailableSlotsHint"]</p>

                <div class="row">
                    @foreach (var slot in Model.FreeReservations)
                    {
                        <div class="col-md-6 col-lg-4 mb-3">
                            <div class="card">
                                <div class="card-header bg-success text-white">
                                    @slot.InstructorAvailability.Room.Name (@slot.InstructorAvailability.Room.RoomNumber)
                                </div>
                                <div class="card-body">
                                    <p class="card-text">
                                        <strong>@Localizer["DateLabel"]</strong> @slot.StartTime.ToString("d", System.Globalization.CultureInfo.CurrentCulture)<br />
                                        <strong>@Localizer["TimeLabel"]</strong> @slot.StartTime.ToString("t", System.Globalization.CultureInfo.CurrentCulture) - @slot.EndTime.ToString("t", System.Globalization.CultureInfo.CurrentCulture)<br />
                                        <strong>@Localizer["InstructorLabel"]</strong> @slot.InstructorAvailability.Instructor.FirstName @slot.InstructorAvailability.Instructor.LastName
                                    </p>
                                    <form method="post" asp-page-handler="Book" asp-route-slotId="@slot.Id">
                                        <button type="submit" class="btn btn-primary w-100">@Localizer["ReserveButton"]</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info mt-3">
                    @Localizer["NoAvailableSlots"]
                </div>
            }
        }
    </div>
</div>
