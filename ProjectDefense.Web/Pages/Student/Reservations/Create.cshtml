@page
@model ProjectDefense.Web.Pages.Student.Reservations.CreateModel

@{
    ViewData["Title"] = Localizer["NewReservationTitle"];
}

<h2>@Localizer["SelectReservationTime"]</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @Localizer["ErrorMessage"]: @TempData["ErrorMessage"]
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @Localizer["SuccessMessage"]: @TempData["SuccessMessage"]
    </div>
}

<form method="post">
    <div class="mb-3">
        <label asp-for="RoomId" class="form-label">@Localizer["RoomLabel"]</label>
        <select asp-for="RoomId" class="form-select" asp-items="Model.RoomSelectList">
            <option value="">@Localizer["SelectRoomOption"]</option>
        </select>
        <span asp-validation-for="RoomId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Date" class="form-label">@Localizer["DateLabel"]</label>
        <input asp-for="Date" type="date" class="form-control" />
        <span asp-validation-for="Date" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SlotId" class="form-label">@Localizer["TimeSlotLabel"]</label>
        <select asp-for="SlotId" class="form-select" asp-items="Model.SlotSelectList">
            <option value="">@Localizer["SelectTimeSlotOption"]</option>
        </select>
        <span asp-validation-for="SlotId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">@Localizer["BookButton"]</button>
    <a asp-page="Index" class="btn btn-secondary">@Localizer["CancelButton"]</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}