@page
@model ProjectDefense.Web.Pages.Student.Rezerwacje.IndexModel
@{
    ViewData["Title"] = "Moje rezerwacje";
}

<div class="row">
    <div class="col-md-12">
        <h1>Moje rezerwacje</h1>

        <a asp-page="History" class="btn btn-outline-info mb-3">Zobacz historię rezerwacji</a>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        
        @if (Model.MojaRezerwacja != null)
        {
            <div class="alert alert-info">
                <h4>Twoja aktualna rezerwacja</h4>
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@Model.MojaRezerwacja.DostepnoscProwadzacego.Sala.Nazwa (@Model.MojaRezerwacja.DostepnoscProwadzacego.Sala.NumerSali)</h5>
                        <p class="card-text">
                            <strong>Data:</strong> @Model.MojaRezerwacja.CzasRozpoczecia.ToString("d", System.Globalization.CultureInfo.CurrentCulture)<br/>
                            <strong>Godziny:</strong> @Model.MojaRezerwacja.CzasRozpoczecia.ToString("t", System.Globalization.CultureInfo.CurrentCulture) - @Model.MojaRezerwacja.CzasZakonczenia.ToString("t", System.Globalization.CultureInfo.CurrentCulture)<br/>
                            <strong>Prowadzący:</strong> @Model.MojaRezerwacja.DostepnoscProwadzacego.Prowadzacy.FirstName @Model.MojaRezerwacja.DostepnoscProwadzacego.Prowadzacy.LastName
                        </p>
                        <form method="post" asp-page-handler="Cancel" class="d-inline">
                            <button type="submit" class="btn btn-danger" onclick="return confirm('Czy na pewno chcesz anulować swoją rezerwację?');">
                                Anuluj rezerwację
                            </button>
                        </form>
                        <a asp-page="Change" class="btn btn-warning">Zmień termin</a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                <strong>Nie masz aktywnej rezerwacji.</strong> Wybierz dostępny termin poniżej.
            </div>

            @if (Model.WolneSloty.Any())
            {
                <h3>Dostępne terminy</h3>
                <p class="text-muted">Kliknij "Zarezerwuj", aby zarezerwować wybrany termin.</p>

                <div class="row">
                    @foreach (var slot in Model.WolneSloty)
                    {
                        <div class="col-md-6 col-lg-4 mb-3">
                            <div class="card">
                                <div class="card-header bg-success text-white">
                                    @slot.DostepnoscProwadzacego.Sala.Nazwa (@slot.DostepnoscProwadzacego.Sala.NumerSali)
                                </div>
                                <div class="card-body">
                                    <p class="card-text">
                                        <strong>Data:</strong> @slot.CzasRozpoczecia.ToString("dd.MM.yyyy")<br/>
                                        <strong>Godziny:</strong> @slot.CzasRozpoczecia.ToString("HH:mm") - @slot.CzasZakonczenia.ToString("HH:mm")<br/>
                                        <strong>Prowadzący:</strong> @slot.DostepnoscProwadzacego.Prowadzacy.FirstName @slot.DostepnoscProwadzacego.Prowadzacy.LastName
                                    </p>
                                    <form method="post" asp-page-handler="Book" asp-route-slotId="@slot.Id">
                                        <button type="submit" class="btn btn-primary w-100">Zarezerwuj</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info mt-3">
                    Brak dostępnych terminów. Sprawdź ponownie później.
                </div>
            }
        }
    </div>
</div>
