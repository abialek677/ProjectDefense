@page
@model ProjectDefense.Web.Pages.Student.Rezerwacje.CreateModel
@{
    ViewData["Title"] = "Nowa rezerwacja";
}

<h2>Wybierz termin rezerwacji</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<form method="post">
    <div class="mb-3">
        <label asp-for="SalaId" class="form-label">Sala</label>
        <select asp-for="SalaId" class="form-select" asp-items="Model.SaleSelectList">
            <option value="">-- Wybierz salę --</option>
        </select>
        <span asp-validation-for="SalaId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Date" class="form-label">Data</label>
        <input asp-for="Date" type="date" class="form-control" />
        <span asp-validation-for="Date" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SlotId" class="form-label">Termin (godzina)</label>
        <select asp-for="SlotId" class="form-select" asp-items="Model.SlotSelectList">
            <option value="">-- Wybierz termin --</option>
        </select>
        <span asp-validation-for="SlotId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Rezerwuj</button>
    <a asp-page="Index" class="btn btn-secondary">Anuluj</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}