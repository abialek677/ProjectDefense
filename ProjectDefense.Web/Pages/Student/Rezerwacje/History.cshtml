@page
@model ProjectDefense.Web.Pages.Student.Rezerwacje.HistoryModel
@{
    ViewData["Title"] = "Moje poprzednie rezerwacje";
}

<h2>Moje poprzednie rezerwacje</h2>

@if (Model.HistoryReservations.Any())
{
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Sala</th>
            <th>Data</th>
            <th>Godzina</th>
            <th>Status</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var rez in Model.HistoryReservations)
        {
            <tr>
                <td>@rez.DostepnoscProwadzacego.Sala.Nazwa</td>
                <td>@rez.CzasRozpoczecia.ToString("d", System.Globalization.CultureInfo.CurrentCulture)</td>
                <td>@rez.CzasRozpoczecia.ToString("t", System.Globalization.CultureInfo.CurrentCulture) - @rez.CzasZakonczenia.ToString("t", System.Globalization.CultureInfo.CurrentCulture)</td>
                <td>
                    @if (rez.StudentId != null)
                    {
                        <span>Zrealizowana</span>
                    }
                    else
                    {
                        <span>Anulowana przez użytkownika</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">Brak poprzednich rezerwacji.</div>
}

<a asp-page="Index" class="btn btn-secondary mt-2">Powrót</a>