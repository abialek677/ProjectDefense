@page
@model ProjectDefense.Web.Pages.Student.Rezerwacje.ChangeModel
@{
    ViewData["Title"] = "Zmień termin rezerwacji";
}

<h2>Zmień termin rezerwacji</h2>

@if (Model.CurrentReservation != null)
{
    <div>
        <strong>Obecna rezerwacja:</strong><br />
        Sala: @Model.CurrentReservation.DostepnoscProwadzacego.Sala.Nazwa<br />
        Data: @Model.CurrentReservation.CzasRozpoczecia.ToString("d", System.Globalization.CultureInfo.CurrentCulture)<br />
        Godzina: @Model.CurrentReservation.CzasRozpoczecia.ToString("t", System.Globalization.CultureInfo.CurrentCulture) - @Model.CurrentReservation.CzasZakonczenia.ToString("t", System.Globalization.CultureInfo.CurrentCulture)
    </div>
}

@if (Model.WolneSloty != null && Model.WolneSloty.Any())
{
    <table class="table table-bordered mt-4">
        <thead>
        <tr>
            <th>Godzina</th>
            <th>Prowadzący</th>
            <th>Akcja</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var slot in Model.WolneSloty)
        {
            <tr>
                <td>@slot.CzasRozpoczecia.ToString("t", System.Globalization.CultureInfo.CurrentCulture) - @slot.CzasZakonczenia.ToString("t", System.Globalization.CultureInfo.CurrentCulture)</td>
                <td>@slot.DostepnoscProwadzacego.Prowadzacy.FirstName</td>
                <td>
                    <form method="post">
                        <input type="hidden" name="NewSlotId" value="@slot.Id" />
                        <button type="submit" class="btn btn-primary btn-sm">
                            Wybierz ten termin
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">Brak dostępnych wolnych terminów w tej sali na ten dzień.</div>
}

<a asp-page="Index" class="btn btn-secondary mt-3">Powrót</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}