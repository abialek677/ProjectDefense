<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Localizer["ProjectDefenseTitle"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-page="/Index">@Localizer["ProjectDefenseTitle"]</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    @if (User.IsInRole("Instructor"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @Localizer["InstructorPanel"]
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                <li><a class="dropdown-item" asp-page="/Instructor/Rooms/Index">@Localizer["RoomsMenu"]</a></li>
                                <li><a class="dropdown-item" asp-page="/Instructor/Availabilities/Index">@Localizer["AvailabilitiesMenu"]</a></li>
                                <li><a class="dropdown-item" asp-page="/Instructor/Reservations/Index">@Localizer["ReservationsMenu"]</a></li>
                                <li><a class="dropdown-item" asp-page="/Instructor/Blocks/Index">@Localizer["BlocksMenu"]</a></li>
                                <li><a class="dropdown-item" asp-page="/Instructor/Export/Index">@Localizer["ExportMenu"]</a></li>
                            </ul>
                        </li>
                    }
                    @if (User.IsInRole("Student"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Student/Reservations/Index">@Localizer["MyReservationsMenu"]</a>
                        </li>
                    }
                </ul>
                <partial name="_LoginPartial" />
                <div class="ms-3">
                    <form method="post" asp-page="/SetLanguage" class="d-inline">
                        <select name="culture" onchange="this.form.submit()" class="form-select form-select-sm">
                            <option value="pl-PL" selected="@(System.Globalization.CultureInfo.CurrentCulture.Name == "pl-PL")">@Localizer["PolishOption"]</option>
                            <option value="en-US" selected="@(System.Globalization.CultureInfo.CurrentCulture.Name == "en-US")">@Localizer["EnglishOption"]</option>
                        </select>
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    </form>
                </div>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
