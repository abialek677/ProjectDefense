@using Microsoft.AspNetCore.Identity
@using ProjectDefense.Shared.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <form asp-area="Identity" asp-page="/Account/Logout" method="post" id="logoutForm" class="form-inline">
                <button type="submit" class="btn btn-link nav-link">@Localizer["LogOut"]</button>
            </form>
        </li>
        <li class="nav-item">
            <span class="nav-link text-dark">
                @string.Format(Localizer["WelcomeUser"], UserManager.GetUserAsync(User).Result.FullName)
            </span>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">@Localizer["LogIn"]</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">@Localizer["Register"]</a>
        </li>
    }
</ul>