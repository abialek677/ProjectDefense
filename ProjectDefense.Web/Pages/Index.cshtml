@page
@model IndexModel

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">@Localizer["HomePageTitle"]</h1>
    <p class="lead">@Localizer["HomePageLead"]</p>

    @if (User.Identity.IsAuthenticated)
    {
        <div class="mt-4">
            @if (User.IsInRole("Instructor"))
            {
                <div class="alert alert-info">
                    <h4>@Localizer["InstructorPanel"]</h4>
                    <p>@Localizer["InstructorWelcome"]</p>
                    <a asp-page="/Instructor/Rooms/Index" class="btn btn-primary">@Localizer["GoToPanel"]</a>
                </div>
            }
            else if (User.IsInRole("Student"))
            {
                <div class="alert alert-success">
                    <h4>@Localizer["StudentPanel"]</h4>
                    <p>@Localizer["StudentWelcome"]</p>
                    <a asp-page="/Student/Reservations/Index" class="btn btn-primary">@Localizer["ViewAvailableSlots"]</a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="mt-4">
            <p>@Localizer["LoginPrompt"]</p>
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary">@Localizer["Login"]</a>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-secondary">@Localizer["Register"]</a>
        </div>
    }
</div>