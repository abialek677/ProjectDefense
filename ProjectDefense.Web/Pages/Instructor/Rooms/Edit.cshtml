@page
@model ProjectDefense.Web.Pages.Instructor.Rooms.Edit
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["EditRoomTitle"];
}

<div class="row">
    <div class="col-md-6">
        <h1>@Localizer["EditRoomHeading"]</h1>

        <form method="post">
            <input type="hidden" asp-for="Room.Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="mb-3">
                <label asp-for="Room.Name" class="form-label">@Localizer["RoomNameLabel"]</label>
                <input asp-for="Room.Name" class="form-control" />
                <span asp-validation-for="Room.Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Room.RoomNumber" class="form-label">@Localizer["RoomNumberLabel"]</label>
                <input asp-for="Room.RoomNumber" class="form-control" />
                <span asp-validation-for="Room.RoomNumber" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">@Localizer["SaveChangesButton"]</button>
                <a asp-page="Index" class="btn btn-secondary">@Localizer["CancelButton"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}