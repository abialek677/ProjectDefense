@page
@model ProjectDefense.Web.Pages.Instructor.Rooms.Edit
@{
    ViewData["Title"] = "Edit Room";
}

<div class="row">
    <div class="col-md-6">
        <h1>Edit Room</h1>

        <form method="post">
            <input type="hidden" asp-for="Room.Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="mb-3">
                <label asp-for="Room.Name" class="form-label">Room Name</label>
                <input asp-for="Room.Name" class="form-control" />
                <span asp-validation-for="Room.Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Room.RoomNumber" class="form-label">Room Number</label>
                <input asp-for="Room.RoomNumber" class="form-control" />
                <span asp-validation-for="Room.RoomNumber" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-page="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}