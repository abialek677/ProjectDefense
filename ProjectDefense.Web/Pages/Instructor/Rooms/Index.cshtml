@page
@model ProjectDefense.Web.Pages.Instructor.Rooms.Index
@{
    ViewData["Title"] = "Manage Rooms";
}

<div class="row">
    <div class="col-md-12">
        <h1>Manage Rooms</h1>

        <p>
            <a asp-page="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Add New Room
            </a>
        </p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (Model.Rooms.Any())
        {
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Number</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var room in Model.Rooms)
                    {
                        <tr>
                            <td>@room.Id</td>
                            <td>@room.Name</td>
                            <td>@room.RoomNumber</td>
                            <td>
                                <a asp-page="Edit" asp-route-id="@room.Id" class="btn btn-sm btn-primary">Edit</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@room.Id" 
                                      class="d-inline" onsubmit="return confirm('Are you sure you want to delete this room?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">
                No rooms available. Add a new room to get started.
            </div>
        }
    </div>
</div>
