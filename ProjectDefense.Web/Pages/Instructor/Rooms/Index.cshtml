@page
@model ProjectDefense.Web.Pages.Instructor.Rooms.Index

@{
    ViewData["Title"] = Localizer["ManageRoomsTitle"];
}

<div class="row">
    <div class="col-md-12">
        <h1>@Localizer["ManageRoomsHeading"]</h1>

        <p>
            <a asp-page="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> @Localizer["AddNewRoomButton"]
            </a>
        </p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (Model.Rooms.Any())
        {
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>@Localizer["IdColumn"]</th>
                        <th>@Localizer["NameColumn"]</th>
                        <th>@Localizer["NumberColumn"]</th>
                        <th>@Localizer["ActionsColumn"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var room in Model.Rooms)
                    {
                        <tr>
                            <td>@room.Id</td>
                            <td>@room.Name</td>
                            <td>@room.RoomNumber</td>
                            <td>
                                <a asp-page="Edit" asp-route-id="@room.Id" class="btn btn-sm btn-primary">@Localizer["EditButton"]</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@room.Id" 
                                      class="d-inline" onsubmit="return confirm('@Localizer["DeleteConfirmMessage"]');">
                                    <button type="submit" class="btn btn-sm btn-danger">@Localizer["DeleteButton"]</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">
                @Localizer["NoRoomsMessage"]
            </div>
        }
    </div>
</div>
