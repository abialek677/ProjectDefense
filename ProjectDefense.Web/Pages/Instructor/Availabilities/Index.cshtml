@page
@model ProjectDefense.Web.Pages.Instructor.Availabilities.IndexModel

@{
    ViewData["Title"] = Localizer["MyAvailabilitiesTitle"];
}

<div class="row">
    <div class="col-md-12">
        <h1>@Localizer["MyAvailabilitiesTitle"]</h1>
        <p>
            <a asp-page="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> @Localizer["AddAvailabilityButton"]
            </a>
        </p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (Model.Availabilities.Any())
        {
            <table class="table table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>@Localizer["TableHeaderRoom"]</th>
                        <th>@Localizer["TableHeaderStartDate"]</th>
                        <th>@Localizer["TableHeaderEndDate"]</th>
                        <th>@Localizer["TableHeaderTime"]</th>
                        <th>@Localizer["TableHeaderSlotDuration"]</th>
                        <th>@Localizer["TableHeaderStatus"]</th>
                        <th>@Localizer["TableHeaderActions"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var availability in Model.Availabilities)
                {
                    <tr class="@(availability.IsBlocked ? "table-danger" : "")">
                        <td>@availability.Room.Name (@availability.Room.RoomNumber)</td>
                        <td>@availability.StartDate.ToString("d")</td>
                        <td>@availability.EndDate.ToString("d")</td>
                        <td>@availability.StartHour.ToString("t") - @availability.EndHour.ToString("t")</td>
                        <td>@availability.SlotDurationMinutes min</td>
                        <td>
                            @if (availability.IsBlocked)
                            {
                                <span class="badge bg-danger">@Localizer["StatusBlocked"]</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@Localizer["StatusActive"]</span>
                            }
                        </td>
                        <td class="d-flex gap-1">
                            @if (!availability.IsBlocked)
                            {
                                <form method="post" asp-page-handler="Block" asp-route-id="@availability.Id">
                                    <button type="submit" class="btn btn-sm btn-warning"
                                            onclick="return confirm('@Localizer["ConfirmBlock"]');">
                                        @Localizer["BlockButton"]
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Unblock" asp-route-id="@availability.Id">
                                    <button type="submit" class="btn btn-sm btn-success">
                                        @Localizer["UnblockButton"]
                                    </button>
                                </form>
                            }
                            <form method="post" asp-page-handler="Delete" asp-route-id="@availability.Id"
                                  onsubmit="return confirm('@Localizer["ConfirmDelete"]');">
                                <button type="submit" class="btn btn-sm btn-danger">@Localizer["DeleteButton"]</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">
                @Localizer["NoAvailabilities"]
            </div>
        }
    </div>
</div>
