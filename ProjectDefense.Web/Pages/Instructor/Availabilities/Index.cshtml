@page
@model ProjectDefense.Web.Pages.Instructor.Availabilities.IndexModel
@{
    ViewData["Title"] = "My Availabilities";
}

<div class="row">
    <div class="col-md-12">
        <h1>My Availabilities</h1>
        <p>
            <a asp-page="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Add Availability
            </a>
        </p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (Model.Availabilities.Any())
        {
            <table class="table table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Room</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Time</th>
                        <th>Slot Duration</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var availability in Model.Availabilities)
                {
                    <tr class="@(availability.IsBlocked ? "table-danger" : "")">
                        <td>@availability.Room.Name (@availability.Room.RoomNumber)</td>
                        <td>@availability.StartDate.ToString("d")</td>
                        <td>@availability.EndDate.ToString("d")</td>
                        <td>@availability.StartHour.ToString("t") - @availability.EndHour.ToString("t")</td>
                        <td>@availability.SlotDurationMinutes min</td>
                        <td>
                            @if (availability.IsBlocked)
                            {
                                <span class="badge bg-danger">Blocked</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td class="d-flex gap-1">
                            @if (!availability.IsBlocked)
                            {
                                <form method="post" asp-page-handler="Block" asp-route-id="@availability.Id">
                                    <button type="submit" class="btn btn-sm btn-warning"
                                            onclick="return confirm('Are you sure you want to block this availability?');">
                                        Block
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Unblock" asp-route-id="@availability.Id">
                                    <button type="submit" class="btn btn-sm btn-success">
                                        Unblock
                                    </button>
                                </form>
                            }
                            <form method="post" asp-page-handler="Delete" asp-route-id="@availability.Id"
                                  onsubmit="return confirm('Are you sure you want to delete this availability? All associated reservations will be removed.');">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">
                You have no availabilities yet. Add a new one to get started.
            </div>
        }
    </div>
</div>
