@page
@model ProjectDefense.Web.Pages.Instructor.Availabilities.CreateModel

@{
    ViewData["Title"] = Localizer["AddAvailabilityTitle"];
    var currentCulture = System.Threading.Thread.CurrentThread.CurrentCulture.Name;
}

<div class="row">
    <div class="col-md-8">
        <h1>@Localizer["AddAvailabilityHeader"]</h1>
        <p class="text-muted">@Localizer["AddAvailabilityDescription"]</p>

        <form method="post">
            <!-- Validation messages -->
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3">@Localizer["ValidationSummaryModelOnly"]</div>

            <!-- Room selection -->
            <div class="mb-3">
                <label asp-for="Availability.RoomId" class="form-label">@Localizer["RoomLabel"]</label>
                <select asp-for="Availability.RoomId" class="form-select" asp-items="Model.RoomSelectList">
                    <option value="">@Localizer["SelectRoomOption"]</option>
                </select>
                <span asp-validation-for="Availability.RoomId" class="text-danger"></span>
            </div>

            <!-- Date selection -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Availability.StartDate" class="form-label">@Localizer["StartDateLabel"]</label>
                    <input asp-for="Availability.StartDate" type="text" class="form-control datepicker" />
                    <span asp-validation-for="Availability.StartDate" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Availability.EndDate" class="form-label">@Localizer["EndDateLabel"]</label>
                    <input asp-for="Availability.EndDate" type="text" class="form-control datepicker" />
                    <span asp-validation-for="Availability.EndDate" class="text-danger"></span>
                </div>
            </div>

            <!-- Time selection -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Availability.StartHour" class="form-label">@Localizer["StartTimeLabel"]</label>
                    <input asp-for="Availability.StartHour" type="text" class="form-control timepicker" />
                    <span asp-validation-for="Availability.StartHour" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Availability.EndHour" class="form-label">@Localizer["EndTimeLabel"]</label>
                    <input asp-for="Availability.EndHour" type="text" class="form-control timepicker" />
                    <span asp-validation-for="Availability.EndHour" class="text-danger"></span>
                </div>
            </div>

            <!-- Slot duration -->
            <div class="mb-3">
                <label asp-for="Availability.SlotDurationMinutes" class="form-label">@Localizer["SlotDurationLabel"]</label>
                <input asp-for="Availability.SlotDurationMinutes" type="number" class="form-control" min="5" max="120" value="15" />
                <span asp-validation-for="Availability.SlotDurationMinutes" class="text-danger"></span>
                <div class="form-text">@Localizer["SlotDurationHint"]</div>
            </div>

            <!-- Action buttons -->
            <div class="mb-3 d-flex gap-2">
                <button type="submit" class="btn btn-success">@Localizer["SaveGenerateButton"]</button>
                <a asp-page="Index" class="btn btn-secondary">@Localizer["CancelButton"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/pl.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var currentCulture = '@currentCulture';
            var locale = currentCulture === 'pl-PL' ? flatpickr.l10ns.pl : flatpickr.l10ns.default;

            // Datepickers
            flatpickr(".datepicker", {
                altInput: true,
                altFormat: currentCulture === 'pl-PL' ? "d.m.Y" : "m/d/Y",
                dateFormat: "Y-m-d",
                locale: locale
            });

            // Timepickers
            flatpickr(".timepicker", {
                enableTime: true,
                noCalendar: true,
                dateFormat: "H:i",
                altInput: true,
                altFormat: currentCulture === 'pl-PL' ? "H:i" : "h:i K",
                time_24hr: currentCulture === 'pl-PL'
            });
        });
    </script>
}
