@page
@model ProjectDefense.Web.Pages.Instructor.Reservations.Reschedule


@{
    ViewData["Title"] = Localizer["RescheduleTitle"];
}

<h2>@Localizer["RescheduleHeading"]</h2>

@if (Model.CurrentReservation != null)
{
    <div class="mb-3">
        <strong>@Localizer["CurrentReservationLabel"]</strong><br />
        @Localizer["RoomLabel"]: @Model.CurrentReservation.InstructorAvailability.Room.Name<br />
        @Localizer["DateLabel"]: @Model.CurrentReservation.StartTime.ToString("d", System.Globalization.CultureInfo.CurrentCulture)<br />
        @Localizer["TimeLabel"]: @Model.CurrentReservation.StartTime.ToString("t", System.Globalization.CultureInfo.CurrentCulture) - 
        @Model.CurrentReservation.EndTime.ToString("t", System.Globalization.CultureInfo.CurrentCulture)<br />
        @Localizer["StudentLabel"]: @Model.CurrentReservation.Student?.FirstName @Model.CurrentReservation.Student?.LastName
    </div>
}

<form method="post">
    <input type="hidden" asp-for="ReservationId" />

    <div class="mb-3">
        <label asp-for="NewSlotId" class="form-label">@Localizer["SelectNewSlotLabel"]</label>
        <select asp-for="NewSlotId" class="form-select">
            <option value="">@Localizer["ChooseSlotOption"]</option>
            @foreach (var slot in Model.AvailableSlots)
            {
                <option value="@slot.Id">
                    @slot.InstructorAvailability.Room.Name
                    (@slot.StartTime.ToString("d", System.Globalization.CultureInfo.CurrentCulture))
                    @slot.StartTime.ToString("t", System.Globalization.CultureInfo.CurrentCulture) -
                    @slot.EndTime.ToString("t", System.Globalization.CultureInfo.CurrentCulture)
                </option>
            }
        </select>
        <span asp-validation-for="NewSlotId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">@Localizer["RescheduleButton"]</button>
    <a asp-page="Index" class="btn btn-secondary">@Localizer["BackButton"]</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
