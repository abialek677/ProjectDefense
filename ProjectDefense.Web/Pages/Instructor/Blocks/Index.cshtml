@page
@model ProjectDefense.Web.Pages.Instructor.Blocks.IndexModel


@{
    ViewData["Title"] = Localizer["ManageBlocksTitle"];
}

<div class="row">
    <div class="col-md-12">
        <h1>@Localizer["ManageBlocksTitle"]</h1>
        
        <p>
            <a asp-page="Create" class="btn btn-danger">
                <i class="bi bi-ban"></i> @Localizer["BanStudentButton"]
            </a>
        </p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (Model.Blocks.Any())
        {
            <table class="table table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>@Localizer["StudentHeader"]</th>
                        <th>@Localizer["EmailHeader"]</th>
                        <th>@Localizer["ReasonHeader"]</th>
                        <th>@Localizer["BanDateHeader"]</th>
                        <th>@Localizer["BannedByHeader"]</th>
                        <th>@Localizer["StatusHeader"]</th>
                        <th>@Localizer["ActionsHeader"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var block in Model.Blocks)
                    {
                        <tr class="@(block.IsActive ? "table-danger" : "table-secondary")">
                            <td>@block.Student.FirstName @block.Student.LastName</td>
                            <td>@block.Student.Email</td>
                            <td>@block.BlockReason</td>
                            <td>@block.BlockDate.ToString("g")</td>
                            <td>@block.BlockingInstructor.FirstName @block.BlockingInstructor.LastName</td>
                            <td>
                                @if (block.IsActive)
                                {
                                    <span class="badge bg-danger">@Localizer["ActiveBadge"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@Localizer["InactiveBadge"]</span>
                                }
                            </td>
                            <td>
                                @if (block.IsActive)
                                {
                                    <form method="post" asp-page-handler="Unblock" asp-route-id="@block.Id" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-success">
                                            @Localizer["UnblockButton"]
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">
                @Localizer["NoBlocksMessage"]
            </div>
        }
    </div>
</div>
