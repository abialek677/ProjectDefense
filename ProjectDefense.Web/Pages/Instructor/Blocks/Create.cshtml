@page
@model ProjectDefense.Web.Pages.Instructor.Blocks.CreateModel
@{
    ViewData["Title"] = "Ban Student";
}

<div class="row">
    <div class="col-md-6">
        <h1>Ban Student</h1>

        <form method="post">
            <!-- Validation summary -->
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Student selection -->
            <div class="mb-3">
                <label asp-for="StudentId" class="form-label">Student</label>
                <select asp-for="StudentId" class="form-select" asp-items="Model.StudentsSelectList">
                    <option value="">-- Select Student --</option>
                </select>
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>

            <!-- Ban reason -->
            <div class="mb-3">
                <label asp-for="Reason" class="form-label">Reason for Ban</label>
                <textarea asp-for="Reason" class="form-control" rows="3" placeholder="Enter the reason for banning this student"></textarea>
                <span asp-validation-for="Reason" class="text-danger"></span>
            </div>

            <!-- Action buttons -->
            <div class="mb-3 d-flex gap-2">
                <button type="submit" class="btn btn-danger">Ban Student</button>
                <a asp-page="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}