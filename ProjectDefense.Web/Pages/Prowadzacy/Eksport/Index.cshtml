@page
@model ProjectDefense.Web.Pages.Prowadzacy.Eksport.IndexModel
@{
    ViewData["Title"] = "Eksport rezerwacji";
}

<div class="row">
    <div class="col-md-8">
        <h1>Eksport wykazu rezerwacji</h1>
        <p class="text-muted">Wybierz salę, zakres dat oraz format eksportu.</p>

        <form method="post">
            <div class="mb-3">
                <label asp-for="SalaId" class="form-label">Sala</label>
                <select asp-for="SalaId" class="form-select" asp-items="Model.SaleSelectList">
                    <option value="">-- Wybierz salę --</option>
                </select>
                <span asp-validation-for="SalaId" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DataOd" class="form-label">Data od</label>
                    <input asp-for="DataOd" type="date" class="form-control" />
                    <span asp-validation-for="DataOd" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="DataDo" class="form-label">Data do</label>
                    <input asp-for="DataDo" type="date" class="form-control" />
                    <span asp-validation-for="DataDo" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Format eksportu</label>
                <div class="btn-group" role="group">
                    <button type="submit" asp-page-handler="ExportTxt" class="btn btn-outline-primary">
                        TXT
                    </button>
                    <button type="submit" asp-page-handler="ExportExcel" class="btn btn-outline-success">
                        XLSX (Excel)
                    </button>
                    <button type="submit" asp-page-handler="ExportPdf" class="btn btn-outline-danger">
                        PDF
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
