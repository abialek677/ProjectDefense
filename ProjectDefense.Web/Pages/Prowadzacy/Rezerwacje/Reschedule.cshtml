@page
@model ProjectDefense.Web.Pages.Prowadzacy.Rezerwacje.RescheduleModel
@{
    ViewData["Title"] = "Przepisz studenta na inny termin";
}

<h2>Przepisz rezerwację studenta</h2>

@if (Model.AktualnaRezerwacja != null)
{
    <div class="mb-3">
        <strong>Aktualnie:</strong><br />
        Sala: @Model.AktualnaRezerwacja.DostepnoscProwadzacego.Sala.Nazwa<br />
        Data: @Model.AktualnaRezerwacja.CzasRozpoczecia.ToString("d", System.Globalization.CultureInfo.CurrentCulture)<br />
        Godzina: @Model.AktualnaRezerwacja.CzasRozpoczecia.ToString("t", System.Globalization.CultureInfo.CurrentCulture) - @Model.AktualnaRezerwacja.CzasZakonczenia.ToString("t", System.Globalization.CultureInfo.CurrentCulture)<br />
        Student: @Model.AktualnaRezerwacja.Student?.FirstName @Model.AktualnaRezerwacja.Student?.LastName
    </div>
}

<form method="post">
    <input type="hidden" asp-for="RezerwacjaId" />

    <div class="mb-3">
        <label asp-for="NowySlotId" class="form-label">Nowy termin:</label>
        <select asp-for="NowySlotId" class="form-select">
            <option value="">-- Wybierz termin --</option>
            @foreach (var slot in Model.WolneSloty)
            {
                <option value="@slot.Id">
                    @slot.DostepnoscProwadzacego.Sala.Nazwa
                    (@slot.CzasRozpoczecia.ToString("d", System.Globalization.CultureInfo.CurrentCulture))
                    @slot.CzasRozpoczecia.ToString("t", System.Globalization.CultureInfo.CurrentCulture)-@slot.CzasZakonczenia.ToString("t", System.Globalization.CultureInfo.CurrentCulture)
                </option>
            }
        </select>
        <span asp-validation-for="NowySlotId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Przepisz</button>
    <a asp-page="Index" class="btn btn-secondary">Wróć</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}