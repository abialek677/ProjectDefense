@page
@model ProjectDefense.Web.Pages.Prowadzacy.Rezerwacje.IndexModel
@{
    ViewData["Title"] = "Zarządzanie rezerwacjami";
}

<div class="row">
    <div class="col-md-12">
        <h1>Wszystkie rezerwacje</h1>

        <form method="get" class="row g-3 mb-3">
            <div class="col-md-3">
                <label for="salaId" class="form-label">Filtruj po sali</label>
                <select name="salaId" class="form-select" onchange="this.form.submit()">
                    <option value="">Wszystkie sale</option>
                    @foreach (var sala in Model.Sale)
                    {
                        <option value="@sala.Id" selected="@(Model.FiltrowanaSalaId == sala.Id)">
                            @sala.Nazwa (@sala.NumerSali)
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Status</label>
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="all" selected="@(Model.Status == "all")">Wszystkie</option>
                    <option value="zajete" selected="@(Model.Status == "zajete")">Zajęte</option>
                    <option value="wolne" selected="@(Model.Status == "wolne")">Wolne</option>
                </select>
            </div>
        </form>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (Model.Rezerwacje.Any())
        {
            <div class="col-md-2">
                <div class="form-check mt-4">
                    <input type="checkbox" class="form-check-input" id="pokazPrzeszle" name="PokazPrzeszle" value="true"
                           @(Model.PokazPrzeszle ? "checked" : "") onchange="this.form.submit()"/>
                    <label class="form-check-label" for="pokazPrzeszle">Pokaż przeszłe</label>
                </div>
            </div>
            <table class="table table-striped table-sm">
                <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Sala</th>
                    <th>Data</th>
                    <th>Godziny</th>
                    <th>Student</th>
                    <th>Email</th>
                    <th>Akcje</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var rez in Model.Rezerwacje)
                {
                    <tr class="@(rez.StudentId != null ? "table-warning" : "")">
                        <td>@rez.Id</td>
                        <td>@rez.DostepnoscProwadzacego.Sala.Nazwa</td>
                        <td>@rez.CzasRozpoczecia.ToString("d", System.Globalization.CultureInfo.CurrentCulture)</td>
                        <td>@rez.CzasRozpoczecia.ToString("t", System.Globalization.CultureInfo.CurrentCulture) - @rez.CzasZakonczenia.ToString("t", System.Globalization.CultureInfo.CurrentCulture)</td>
                        <td>
                            @if (rez.Student != null)
                            {
                                <span>@rez.Student.FirstName @rez.Student.LastName</span>
                            }
                            else
                            {
                                <span class="text-muted">Wolny</span>
                            }
                        </td>
                        <td>@rez.Student?.Email</td>
                        <td>
                            @if (rez.CzasZakonczenia > DateTime.UtcNow)
                            {
                                @if (rez.StudentId != null)
                                {
                                    <form method="post" asp-page-handler="Cancel" asp-route-id="@rez.Id"
                                          class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-danger"
                                                onclick="return confirm('Czy na pewno chcesz anulować tę rezerwację?');">
                                            Anuluj
                                        </button>
                                    </form>

                                    <a asp-page="Reschedule" asp-route-id="@rez.Id" class="btn btn-sm btn-primary">
                                        Przepisz
                                    </a>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Zakończona</span>
                            }
                        <td>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@rez.Id" class="d-inline"
                                  onsubmit="return confirm('Czy na pewno chcesz usunąć ten slot na stałe?');">
                                <button type="submit" class="btn btn-sm btn-danger">
                                    Usuń na stałe
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">
                Brak rezerwacji spełniających kryteria.
            </div>
        }
    </div>
</div>
