@page
@model ProjectDefense.Web.Pages.Prowadzacy.Sale.EditModel
@{
    ViewData["Title"] = "Edytuj salę";
}

<div class="row">
    <div class="col-md-6">
        <h1>Edytuj salę</h1>

        <form method="post">
            <input type="hidden" asp-for="Sala.Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="mb-3">
                <label asp-for="Sala.Nazwa" class="form-label">Nazwa sali</label>
                <input asp-for="Sala.Nazwa" class="form-control" />
                <span asp-validation-for="Sala.Nazwa" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Sala.NumerSali" class="form-label">Numer sali</label>
                <input asp-for="Sala.NumerSali" class="form-control" />
                <span asp-validation-for="Sala.NumerSali" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Zapisz zmiany</button>
                <a asp-page="Index" class="btn btn-secondary">Anuluj</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}