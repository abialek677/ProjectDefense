@page
@model ProjectDefense.Web.Pages.Prowadzacy.Sale.IndexModel
@{
    ViewData["Title"] = "Zarządzanie salami";
}

<div class="row">
    <div class="col-md-12">
        <h1>Zarządzanie salami</h1>
        <p>
            <a asp-page="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Dodaj nową salę
            </a>
        </p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (Model.Sale.Any())
        {
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nazwa</th>
                        <th>Numer sali</th>
                        <th>Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sala in Model.Sale)
                    {
                        <tr>
                            <td>@sala.Id</td>
                            <td>@sala.Nazwa</td>
                            <td>@sala.NumerSali</td>
                            <td>
                                <a asp-page="Edit" asp-route-id="@sala.Id" class="btn btn-sm btn-primary">Edytuj</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@sala.Id" class="d-inline" 
                                      onsubmit="return confirm('Czy na pewno chcesz usunąć tę salę?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Usuń</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">
                Brak sal w systemie. Dodaj nową salę, aby rozpocząć.
            </div>
        }
    </div>
</div>
