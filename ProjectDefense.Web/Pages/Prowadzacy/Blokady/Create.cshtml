@page
@model ProjectDefense.Web.Pages.Prowadzacy.Blokady.CreateModel
@{
    ViewData["Title"] = "Zbanuj studenta";
}

<div class="row">
    <div class="col-md-6">
        <h1>Zbanuj studenta</h1>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="StudentId" class="form-label">Student</label>
                <select asp-for="StudentId" class="form-select" asp-items="Model.StudenciSelectList">
                    <option value="">-- Wybierz studenta --</option>
                </select>
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Powod" class="form-label">Powód blokady</label>
                <textarea asp-for="Powod" class="form-control" rows="3" placeholder="Podaj powód zbanowania studenta"></textarea>
                <span asp-validation-for="Powod" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-danger">Zbanuj</button>
                <a asp-page="Index" class="btn btn-secondary">Anuluj</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
